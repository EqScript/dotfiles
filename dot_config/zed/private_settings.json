// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "minimap": {
        "show": "auto"
    },
    "tab_size": 4,
    "hard_tabs": false,
    "ui_font_family": "Hack Nerd Font Mono",
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "vim_mode": true,
    "icon_theme": "Colored Zed Icons Theme Dark",
    "ui_font_size": 20,
    "buffer_font_size": 20,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "ChatGPT (EqScript)"
    },
    "lsp": {
        "clangd": {
            "binary": {
                // NOTE: The exact path may vary based on your system,
                // but this is a common location for a symlink to the store path.
                "path": "/run/current-system/sw/bin/clangd"
            },
            "initialization_options": {
                "clangd": {
                    "fallbackFlags": [
                        "-Wno-unused-includes",
                        "typecheck_invalid_operands"
                    ]
                }
            }
        }
    },
    "terminal": {
        "font_family": "JetBrainsMono Nerd Font Mono",
        "font_size": 20
    },
    "languages": {
        "Python": {
            "language_servers": [
                // Disable basedpyright and enable Ty, and otherwise use the default configuration.
                "ty",
                "!basedpyright",
                "..."
            ]
        }
    }
}
