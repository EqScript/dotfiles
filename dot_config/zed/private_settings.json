// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "terminal": {
    "font_family": "Terminess Nerd Font Mono",
    "font_size": 20.0
  },
  "relative_line_numbers": "enabled",
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "cursor_shape": {
      "insert": "bar"
    }
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
    "enable_preview_from_project_panel": false,
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enabled": true,
  },
  "text_rendering_mode": "platform_default",
  "ui_font_family": "BlexMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "active_pane_modifiers": {
    "border_size": 2.0,
    "inactive_opacity": 0.8,
  },
  "tabs": {
    "git_status": true,
  },
  "search": {
    "button": true,
  },
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Zedokai Darker (Filter Spectrum)",
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--compile-commands-dir=.",
          "--query-driver=**/*xtensa-esp32*-elf-gcc*",
          "--header-insertion=never",
        ],
      },
    },
  },
}
