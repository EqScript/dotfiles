# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
for dir in \
  "$HOME/.cargo/bin" \
  "$HOME/.local/bin" \
  "$HOME/bin" \
  "$HOME/.platformio/penv/bin" \
  "$HOME/.config/scripts" \
  "/opt/RustRover-2025.2.5/bin/" \
  "/srv/firmware/" \
  "$HOME/.local/bin"
do
    case ":$PATH:" in
        *":$dir:"*) ;; # already in PATH
        *) PATH="$dir:$PATH" ;;
    esac
done
export PATH

# Env Variables
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR=nvim

# Utilities
alias zz='z ..'
alias ya='yazi'
alias la='ls -lha'
alias rm='trash'

# Git
alias ga='git add .'
alias gc='git commit -m'
alias gst='git status'
alias gl='git pull'
alias gp='git push'
alias sg='ssh-add ~/.ssh/mifd-git-full'

# Configs
alias bashcfg='nvim ~/.local/share/chezmoi/executable_dot_bashrc && chezmoi apply && source $HOME/.bashrc'
alias bashsrc='source ~/.bashrc'
alias hyprcfg='nvim ~/.local/share/chezmoi/dot_config/hypr/hyprland.conf && chezmoi apply'
chezcfg() { 
  nvim $HOME/.local/share/chezmoi/dot_config"$@"
}

# Window Manager
alias wppr='~/.config/wallpapers/next-wallpaper.sh'
alias logout='loginctl terminate-user $USER'
alias sus='systemctl suspend'
alias shutd='shutdown now'

# Others
alias cl='clear'
alias lg='ssh-add $HOME/.ssh/mifd-git-full && lazygit'
alias syshmi='ssh-add $HOME/.ssh/mbp-fd-system-hmi-syshmi && ssh syshmi@192.168.10.103'
alias radxa='ssh-add $HOME/.ssh/mbp-fd-radxa && ssh sergio@192.168.10.105'
alias usb0='tio /dev/ttyUSB0'
alias acm0='tio /dev/ttyACM0'
alias battery='upower -i /org/freedesktop/UPower/devices/DisplayDevice'

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

eval "$(ssh-agent -s)"  >/dev/null
eval "$(starship init bash)"
eval "$(zoxide init bash)"
. "$HOME/.cargo/env"
